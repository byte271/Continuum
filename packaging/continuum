#!/bin/sh
set -eu

launcher=$0
while [ -L "$launcher" ]; do
    link=$(readlink "$launcher")
    case "$link" in
        /*) launcher=$link ;;
        *) launcher=$(dirname -- "$launcher")/$link ;;
    esac
done

bundle_root=$(
    CDPATH= cd -- "$(dirname -- "$launcher")/.." >/dev/null 2>&1
    pwd -P
)

export PYTHONHOME="$bundle_root/runtime"
export PYTHONPATH="$bundle_root/app"
export CONTINUUM_BUNDLE_MANIFEST="$bundle_root/runtime-manifest.json"

exec "$bundle_root/runtime/bin/python3.12" -m continuum "$@"
